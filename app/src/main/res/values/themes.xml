<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Splash screen theme -->
	<style name="Theme.SprintZeroTemplate.Splash" parent="Theme.SplashScreen.IconBackground">
		<item name="windowSplashScreenBackground">@color/green</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
		<item name="postSplashScreenTheme">@style/Theme.SprintZeroTemplate</item>
	</style>

	<!-- Main theme -->
	<style name="Theme.SprintZeroTemplate" parent="Theme.Material3.Light.NoActionBar">
		<!-- Primary brand color -->
		<item name="colorPrimary">@color/red</item>
		<item name="colorOnPrimary">@color/white</item>
		<item name="colorPrimaryContainer">@color/red_container</item>
		<item name="colorOnPrimaryContainer">@color/red</item>
		<!-- Secondary brand color -->
		<item name="colorSecondary">@color/blue</item>
		<item name="colorOnSecondary">@color/white</item>
		<!-- Status bar color -->
		<item name="android:statusBarColor">@color/transparent</item>
		<item name="android:windowLightStatusBar">false</item>
		<item name="android:windowTranslucentNavigation">true</item>
	</style>

	<!-- Pill indicator shown behind the selected bottom nav item icon -->
	<style name="Widget.SprintZeroTemplate.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
		<item name="android:color">@color/red_container</item>
	</style>
</resources>